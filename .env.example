# --- Instagram bot account (the account that receives your shared posts) ---
IG_USERNAME=your_bot_account_username
IG_PASSWORD=your_bot_account_password

# Numeric IG user id of YOUR personal account (the only sender the bot trusts).
# Find it by running:  python -c "from instagrapi import Client; c=Client(); \
#   c.login('BOT_USER','BOT_PASS'); print(c.user_id_from_username('your_handle'))"
ALLOWED_SENDER_ID=123456789

# --- Google Gemini (free tier) ---
# Get a free key (no card) at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...
# Extraction model. gemini-2.5-flash is free-tier and plenty for this; you can
# switch to gemini-2.0-flash for higher free rate limits.
GEMINI_MODEL=gemini-2.5-flash

# --- Optional knobs (defaults shown) ---
# DB_PATH=data/db.sqlite
# IG_SESSION_PATH=data/session.json
# COMMENTS_LIMIT=25
# COMMENTS_FETCH_LIMIT=100
# CONFIDENCE_THRESHOLD=0.4

# --- Official Instagram Messaging API (for webhook mode) ---
# Switch bot account to Business/Creator in the app first.
# Then create a Meta Developer App at developers.facebook.com.

# Long-lived Page Access Token from Meta Developer Console.
IG_ACCESS_TOKEN=

# App Secret from App Settings → Basic in Meta Developer Console.
IG_APP_SECRET=

# Any string you choose — must match what you enter in Meta's webhook config.
WEBHOOK_VERIFY_TOKEN=

# Numeric Instagram user ID of the bot account.
# Find it: Settings → Account → tap username area, ID shown in URL, or use
#   curl "https://graph.facebook.com/v21.0/me?fields=id&access_token=YOUR_TOKEN"
IG_USER_ID=

# NOTE: ALLOWED_SENDER_ID must be the IGSID of your personal account when using
# the webhook. Confirm it by running the bot once and checking logs for:
#   "Ignoring untrusted sender <id>"  ← that's your IGSID.
# It may differ from the instagrapi user ID.
